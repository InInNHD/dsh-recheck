{
  "name": "dsh-recheck",
  "version": "0.1.0-beta.1",
  "description": "Track conclusions and revisit them when evidence files change.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/*.js",
    "lib/*.map",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs/09-implementation-and-acceptance.md",
    "README.en.md",
    "CHANGELOG.md",
    "docs/12-installation.md",
    "docs/13-public-release-validation.md",
    "docs/assets/*.png",
    "docs/14-npm-release-validation.md",
    "docs/15-ui-refresh.md",
    "compatibility.json",
    "docs/17-alpha5-acceptance.md",
    "docs/16-ecosystem-research-and-roadmap.md",
    "docs/18-alpha6-acceptance.md",
    "docs/19-beta1-acceptance.md",
    "docs/assets/*.gif",
    "docs/20-stable-release-readiness.md",
    "docs/21-trial-and-recovery.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json",
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run check",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "test:web": "node scripts/web-smoke.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "test:ui": "node scripts/ui-smoke.mjs"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4 || 4.0.5-alpha.1",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-fs": "0.2.0-rc.2 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-sandbox": "0.2.0-rc.2 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.0-rc.2 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2 || 0.2.1-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@types/node": "24.19.1",
    "@types/react": "18.3.31",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "react": "18.3.1",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InInNHD/dsh-recheck.git"
  },
  "homepage": "https://github.com/InInNHD/dsh-recheck#readme",
  "bugs": {
    "url": "https://github.com/InInNHD/dsh-recheck/issues"
  },
  "author": "InInNHD",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "recheck",
    "evidence",
    "review"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "tag": "beta"
  }
}
